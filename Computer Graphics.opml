<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>CVI</title>
  </head>
  <body>
    <outline text="CVI">
      <outline text="Particulas"></outline>
      <outline text="Iluminación "></outline>
      <outline text="Eventos"></outline>
      <outline text="2D">
        <outline text="Sprites"></outline>
      </outline>
      <outline text="3D">
        <outline text="Modelos"></outline>
        <outline text="Texturas"></outline>
        <outline text="Shaders"></outline>
        <outline text="Cámara ">
          <outline text="Perspectiva"></outline>
        </outline>
      </outline>
      <outline text="Animaciones"></outline>
      <outline text="Color"></outline>
      <outline text="Matemáticas ">
        <outline text="Álgebra lineal">
          <outline text="Transformaciones">
            <outline text="Traslación "></outline>
            <outline text="Rotación ">
              <outline text="Quaternions"></outline>
              <outline text="Angulos de Euler"></outline>
            </outline>
            <outline text="Escalamiento"></outline>
            <outline text="Shearing"></outline>
          </outline>
          <outline text="Vectores">
            <outline text="Producto cruz">
              <outline text="Vector normal"></outline>
            </outline>
            <outline text="Producto punto"></outline>
          </outline>
          <outline text="Matrices ">
            <outline text="Homogeneas"></outline>
          </outline>
          <outline text="Determinantes">
            <outline text="Areas"></outline>
          </outline>
        </outline>
        <outline text="Geometría"></outline>
        <outline text="Cálculo">
          <outline text="Integrales"></outline>
          <outline text="Curvas"></outline>
          <outline text="Gradiente"></outline>
        </outline>
        <outline text="Trigonometría ">
          <outline text="Triángulos "></outline>
        </outline>
      </outline>
    </outline>
  </body>
</opml>