<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>CVI</title>
  </head>
  <body>
    <outline text="CVI">
      <outline text="Particulas"></outline>
      <outline text="Iluminación "></outline>
      <outline text="Eventos"></outline>
      <outline text="2D">
        <outline text="Sprites"></outline>
      </outline>
      <outline text="3D">
        <outline text="Modelos"></outline>
        <outline text="Texturas"></outline>
        <outline text="Shaders"></outline>
        <outline text="Cámara ">
          <outline text="Perspectiva"></outline>
        </outline>
      </outline>
      <outline text="Animaciones"></outline>
      <outline text="Color"></outline>
      <outline text="Matemáticas ">
        <outline text="Álgebra lineal">
          <outline text="Transformaciones">
            <outline text="Traslación "></outline>
            <outline text="Rotación ">
              <outline text="Quaternions"></outline>
              <outline text="Angulos de Euler"></outline>
            </outline>
            <outline text="Escalamiento"></outline>
            <outline text="Shearing"></outline>
          </outline>
          <outline text="Vectores">
            <outline text="Producto cruz">
              <outline text="Vector normal"></outline>
            </outline>
            <outline text="Producto punto"></outline>
          </outline>
          <outline text="Matrices ">
            <outline text="Homogeneas"></outline>
          </outline>
          <outline text="Determinantes">
            <outline text="Areas"></outline>
          </outline>
        </outline>
        <outline text="Geometría"></outline>
        <outline text="Cálculo">
          <outline text="Integrales"></outline>
          <outline text="Curvas"></outline>
          <outline text="Gradiente"></outline>
        </outline>
        <outline text="Trigonometría ">
          <outline text="Triángulos "></outline>
        </outline>
      </outline>
      <outline text="Métodos de renderizado">
        <outline text="Imágenes Raster">
          <outline text="Pixeles">
            <outline text="Color">
              <outline text="RGBA">
                <outline text="RGB"></outline>
                <outline text="Canal alpha"></outline>
              </outline>
              <outline text="Representaciones de bit"></outline>
              <outline text="Representaciones&#10;de 0 a 1"></outline>
              <outline text="Antialiasing"></outline>
            </outline>
          </outline>
          <outline text="Tamaño">
            <outline text="Reescalado"></outline>
          </outline>
          <outline text="Velocidad entre&#10;imagenes (fps)"></outline>
          <outline text="Dispositivos">
            <outline text="Salida">
              <outline text="Impresos"></outline>
              <outline text="Displays">
                <outline text="Gamma"></outline>
              </outline>
            </outline>
            <outline text="Entrada">
              <outline text="Lentes">
                <outline text="Luz"></outline>
              </outline>
            </outline>
          </outline>
          <outline text="Formatos">
            <outline text="Jpeg"></outline>
            <outline text="Tiff"></outline>
            <outline text="Ppm"></outline>
            <outline text="Png"></outline>
          </outline>
        </outline>
        <outline text="Ray tracing"></outline>
      </outline>
    </outline>
  </body>
</opml>